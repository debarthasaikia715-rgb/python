import json
import os
from datetime import datetime, timedelta
from typing import Dict, List

DATA_FILE = "habits.json"

def load_habits() -> Dict:
    if not os.path.exists(DATA_FILE):
        return {"habits": [], "history": {}}
    
    try:
        with open(DATA_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except:
        print("Cannot read habits file. Starting fresh.")
        return {"habits": [], "history": {}}


def save_habits(data: Dict):
    try:
        with open(DATA_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
        print("→ Habits saved.")
    except Exception as e:
        print(f"Error saving: {e}")


def add_new_habit(data: Dict):
    name = input("New habit name: ").strip()
    if not name:
        print("Name cannot be empty.")
        return
    
    if name in data["habits"]:
        print("You already track this habit.")
        return
    
    data["habits"].append(name)
    # Initialize history for this habit
    if name not in data["history"]:
        data["history"][name] = {}
    
    print(f"Habit '{name}' added.")


def mark_today(data: Dict):
    today = datetime.now().date().isoformat()
    
    if not data["habits"]:
        print("You have no habits yet. Add some first.")
        return
    
    print("\nMark habits for today (" + today + "):")
    for habit in data["habits"]:
        while True:
            ans = input(f"  {habit} ? (y/n): ").strip().lower()
            if ans in ("y", "n"):
                break
            print("Please answer y or n.")
        
        # Save only completed habits (True)
        if ans == "y":
            data["history"][habit][today] = True
        # We don't need to save False → saves space


def show_streaks_and_stats(data: Dict):
    if not data["habits"]:
        print("No habits to show yet.")
        return
    
    today = datetime.now().date()
    print("\n" + "═" * 50)
    print("HABIT TRACKER STATUS".center(50))
    print("═" * 50)
    
    for habit in data["habits"]:
        dates = data["history"].get(habit, {})
        completed_dates = [datetime.fromisoformat(d).date() 
                          for d in dates if dates[d] is True]
        
        if not completed_dates:
            print(f"{habit:20} • never completed")
            continue
        
        # Current streak
        current_streak = 0
        check_date = today
        while check_date in completed_dates or check_date == today:
            if check_date in completed_dates:
                current_streak += 1
            else:
                break
            check_date -= timedelta(days=1)
        
        # Longest streak
        longest = 1
        current = 1
        prev = None
        for d in sorted(completed_dates):
            if prev is None:
                prev = d
                continue
            if (d - prev).days == 1:
                current += 1
                longest = max(longest, current)
            else:
                current = 1
            prev = d
        
        # Last 30 days success rate
        last_30_start = today - timedelta(days=29)
        days_in_period = 0
        success_days = 0
        for i in range(30):
            d = today - timedelta(days=i)
            if d >= last_30_start:
                days_in_period += 1
                if d in completed_dates:
                    success_days += 1
        
        rate = (success_days / days_in_period * 100) if days_in_period > 0 else 0
        
        print(f"{habit:20} • current streak: {current_streak:3d}  • longest: {longest:3d}  • 30d: {rate:5.1f}%")
    
    print("═" * 50 + "\n")


def show_simple_calendar(data: Dict, days_back: int = 35):
    today = datetime.now().date()
    start_date = today - timedelta(days=days_back)
    
    print(f"\nLast {days_back} days calendar:")
    print(" Habit".ljust(18), end="")
    
    for i in range(days_back, -1, -1):
        d = today - timedelta(days=i)
        print(d.strftime("%d").rjust(3), end="")
    print()
    
    for habit in data["habits"]:
        print(habit.ljust(18), end="")
        for i in range(days_back, -1, -1):
            d = today - timedelta(days=i)
            date_str = d.isoformat()
            mark = " ✓" if data["history"].get(habit, {}).get(date_str) else " ·"
            print(mark.rjust(3), end="")
        print()
    print()


def main():
    data = load_habits()
    
    while True:
        print("\n" + "═" * 38)
        print("      HABIT TRACKER")
        print("═" * 38)
        print("1. Add new habit")
        print("2. Mark today's habits")
        print("3. Show streaks & statistics")
        print("4. Show calendar view")
        print("5. Save and exit")
        print("6. Exit without saving")
        print("═" * 38)
        
        choice = input("Choose (1-6): ").strip()
        
        if choice == "1":
            add_new_habit(data)
        elif choice == "2":
            mark_today(data)
        elif choice == "3":
            show_streaks_and_stats(data)
        elif choice == "4":
            show_simple_calendar(data)
        elif choice == "5":
            save_habits(data)
            print("Goodbye! Data saved.")
            break
        elif choice == "6":
            print("Exiting without saving changes.")
            break
        else:
            print("Please choose 1–6.")


if __name__ == "__main__":
    main()
